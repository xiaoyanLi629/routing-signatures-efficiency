# HCP data and model weights are never versioned
data/
models/
# Pipeline outputs (the paper's group-level numbers live in results/summary/)
results/run_*/
logs/
__pycache__/
*.py[cod]
.venv/
.DS_Store

# LaTeX build artifacts (the .tex, .cls, .bib, figures and the compiled PDF
# are tracked; the intermediate files are not)
*.aux
*.log
*.blg
*.fls
*.fdb_latexmk
*.out
*.run.xml
*.bcf
*.synctex.gz
papers/conference_BIBM2026/*.tar.gz
